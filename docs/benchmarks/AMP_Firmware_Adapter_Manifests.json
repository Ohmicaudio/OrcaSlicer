      "touchscreen_safe": false,
      "fluidd_only": true,
      "requires_hardware_validation": true,
      "command_style": "snapmaker_fluidd_klipper",
      "state_save_command": "SAVE_GCODE_STATE NAME=amp_toolchange",
      "state_restore_command": "RESTORE_GCODE_STATE NAME=amp_toolchange",
      "purge_wipe_macro": "AMP_PURGE_OR_WIPE",
      "tool_map": {
        "0.2": { "tool_id": "T0", "nozzle_diameter_mm": 0.2, "macro_name": "AMP_PICK_TOOL", "offset": { "x": "hardware_required", "y": "hardware_required", "z": "hardware_required" } },
        "0.4": { "tool_id": "T1", "nozzle_diameter_mm": 0.4, "macro_name": "AMP_PICK_TOOL", "offset": { "x": "hardware_required", "y": "hardware_required", "z": "hardware_required" } },
        "0.6": { "tool_id": "T2", "nozzle_diameter_mm": 0.6, "macro_name": "AMP_PICK_TOOL", "offset": { "x": "hardware_required", "y": "hardware_required", "z": "hardware_required" } },
        "0.8": { "tool_id": "T3", "nozzle_diameter_mm": 0.8, "macro_name": "AMP_PICK_TOOL", "offset": { "x": "hardware_required", "y": "hardware_required", "z": "hardware_required" } }
      },
      "safety_warnings": [
        "Developer-only future path.",
        "Requires U1 hardware validation before executable commands are considered.",
        "Do not use for touchscreen-started mixed physical nozzle jobs."
      ]
    },
