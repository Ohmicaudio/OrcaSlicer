{
  "schema_version": "0.1",
  "purpose": "AMP firmware/controller execution adapter examples for comments-only pseudo emission.",
  "adapters": [
    {
      "adapter_id": "snapmaker_touchscreen_blocked",
      "adapter_name": "Snapmaker Touchscreen Blocked Advisory Adapter",
      "target_controller": "Snapmaker U1 touchscreen",
      "supports_toolchange_commands": false,
      "supports_per_tool_offsets": false,
      "supports_per_tool_heaters": false,
      "supports_standby_temperature": false,
      "supports_tool_parking": false,
      "supports_state_save_restore": false,
      "supports_purge_wipe_macros": false,
      "supports_nozzle_metadata": false,
      "touchscreen_safe": false,
      "fluidd_only": false,
      "requires_hardware_validation": true,
      "command_style": "blocked",
      "tool_map": {
        "0.2": { "tool_id": "T0", "nozzle_diameter_mm": 0.2 },
        "0.4": { "tool_id": "T1", "nozzle_diameter_mm": 0.4 },
        "0.6": { "tool_id": "T2", "nozzle_diameter_mm": 0.6 },
        "0.8": { "tool_id": "T3", "nozzle_diameter_mm": 0.8 }
      },
      "safety_warnings": [
        "Touchscreen-started mixed physical nozzle execution remains blocked.",
        "Use this adapter for advisory schedule review only."
      ]
    },
    {
      "adapter_id": "snapmaker_fluidd_klipper_experimental",
      "adapter_name": "Snapmaker Fluidd Klipper Experimental Adapter",
      "target_controller": "Snapmaker U1 Fluidd/Klipper path",
      "supports_toolchange_commands": true,
      "supports_per_tool_offsets": true,
      "supports_per_tool_heaters": "unknown",
      "supports_standby_temperature": "unknown",
      "supports_tool_parking": "future_macro",
